##
Overview parameters
usage: soul run test_overview.soul --folder {folder}
##

str folder = arg("--folder")

overviewinfo ov = overview(folder)

int files = overviewFiles(ov)
int dirs  = overviewDirs(ov)
int totalSize = overviewSize(ov)

printStr("Files:")
print(files)

printStr("Dirs:")
print(dirs)

printStr("Size:")
print(totalSize)

int n = overviewExtCount(ov)
int i = 0

printStr("Overview:")
printStr(concat("  Files: ", toStr(files)))
printStr(concat("  Dirs:  ", toStr(dirs)))
printStr(concat("  Size:  ", toStr(totalSize)))
printStr("")
printStr("By extension:")

while i < n:
    str ext = overviewExtName(ov, i)
    int f   = overviewExtFiles(ov, i)
    int s   = overviewExtSize(ov, i)

    str line = "  "
    line = concat(line, ext)
    line = concat(line, "  files: ")
    line = concat(line, toStr(f))
    line = concat(line, "  size: ")
    line = concat(line, toStr(s))

    printStr(line)

    i = i + 1
    
printStr(" ")
printStr("Built with Soul")
printStr("Create your own high-performance tools at soul-run.com")