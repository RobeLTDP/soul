##
Create log for a tree structure
Uso: soul run log.soul --folder {carpeta}
##

str folder = arg("--folder")
if folder == "":
    printStr("ERROR: missing --folder")
    return

str base = concat("/home/dmin/dev/soulc/", folder)
diriter it = listdir(base)

str out = concat(base, "/log.json")
int f = open(out)

write(f, "[")

str sep = ""

while true:
    str name = dir_next(it)
    if name == 0:
        break

    str full = join(base, name)

    statinfo st = stat(full)
    if st == 0:
        continue

    if isdir(st):
        int ts = mtime(full)

        str p0 = json_pair_str("type", "folder")
        str p1 = json_pair_str("name", name)
        str p2 = json_pair_int("mtime", ts)
        str p3 = json_pair_str("location", folder)

        str obj = json_object(p0, p1, p2, p3)

        write(f, sep)
        write(f, obj)

        sep = ","

    if isfile(st):
        int ts = mtime(full)

        str p0 = json_pair_str("type", "file")
        str p1 = json_pair_str("name", name)
        str p2 = json_pair_int("mtime", ts)
        str p3 = json_pair_str("location", folder)

        str obj = json_object(p0, p1, p2, p3)

        write(f, sep)
        write(f, obj)

        sep = ","

end

write(f, "]")
close(f)
dir_close(it)

printStr("JSON written to:")
printStr(out)
