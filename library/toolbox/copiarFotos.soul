##
Copiar todos los ficheros desde D:\100KC360 a /fotos
(entorno: WSL)
##

str source = "/mnt/key2media/100KC360"
str target = "/home/dmin/dev/soulc/examples/fotos"

mkdir(target)

diriter it = listdir(source)

while true:
    str name = dir_next(it)
    if name == 0:
        break

    str src = concat(source, "/")
    src = concat(src, name)

    str dst = concat(target, "/")
    dst = concat(dst, name)

    copy(src, dst)

dir_close(it)
printStr("Copia finalizada")
