##
Recorre recursivamente un directorio y lista todos los ficheros
uso: soul run walk_list.soul --folder {ruta}
##

str folderOrigen = arg("--folder")
str folder = concat("/home/dmin/dev/soulc/", folderOrigen)

str buscar = arg("--buscar")

printStr("Walking:")
printStr(folder)
printStr("")

diriter it = walk(folder)

while true:
    str p = walk_next(it)
    if p == 0:
        break

    if buscar !="":
        if endswith(p, buscar):
            printStr(" ")
            printStr("ARCHIVO ENCONTRADO EN ESTA RUTA:")
            printStr(p)

    any st = stat(p)
    if isdir(st):
        printStr(p)

walk_close(it)

printStr("")
printStr("FIN")
