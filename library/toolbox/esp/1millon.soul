##
Crear 1.000.000 ficheros distribuidos entre 10 carpetas
uso: soul run 1millon.soul --folder {carpeta_base}
##

str folderOrigen = arg("--folder")
str folder = concat("/home/dmin/dev/soulc/", folderOrigen)
str base = concat(folder, "/")

if base == "":
    printStr("ERROR: missing --folder")
    return

mkdir(base)

##
Configuración
##
int numDirs = 10
int filesPerDir = 100000

printStr("Base:")
printStr(base)
printStr("Carpetas:")
print(numDirs)
printStr("Ficheros por carpeta:")
print(filesPerDir)
printStr("")

##
Crear subcarpetas dir1 .. dir10
##
int d = 1
while d <= numDirs:
    str dirName = concat("dir", toStr(d))
    str dirPath = concat(base, dirName)
    mkdir(dirPath)
    d = d + 1

##
Crear ficheros
##
int total = 0
d = 1

while d <= numDirs:    
    str dirName = concat("dir", toStr(d))
    str dirPath = concat(base, dirName)

    int i = 0
    while i < filesPerDir:
        str name = concat("file_", toStr(i))
        name = concat(name, ".txt")

        # path TEMPORAL (una vez por fichero)
        str path = concat(dirPath, "/")
        path = concat(path, name)

        file h = open(path)
        write(h, "Done!\n")
        close(h)

        i = i + 1
        total = total + 1

    d = d + 1

printStr("")
printStr("FIN")
print(total)
