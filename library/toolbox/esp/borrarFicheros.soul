##
Borra todos los ficheros de una carpeta
Uso: soul run borrarFicheros.soul --folder {carpeta}
##


str carpeta = arg("--folder", "outA")
str folder = concat("/home/dmin/dev/soulc/", carpeta)   

printStr(folder)
diriter it = listdir(folder)

while true:
    diriter it = listdir(folder)
    int removed = 0

    while true:
        str name = dir_next(it)
        if name == 0:
            break

        str fullPath = concat(folder, "/")
        fullPath = concat(fullPath, name)
        remove(fullPath)
        removed = removed + 1

    dir_close(it)

    if removed == 0:
        break


dir_close(it)

