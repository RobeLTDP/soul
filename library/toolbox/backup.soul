##
Incremental backup for a source folder
Usage: soul run backup.soul --folderSrc {source_folder} --folderDst {destination_folder}
##

str folderSrc = arg("--folderSrc")
str folderDst = arg("--folderDst")

str src = concat("/home/dmin/dev/soulc/", folderSrc)
str dst = concat("/home/dmin/dev/soulc/", folderDst)

printStr("Starting backup...")

printStr("Source:")
printStr(src)
printStr("Destination:")
printStr(dst)

# Create destination folder
mkdir(dst)

# Execute backup
backup(src, dst)

printStr("Backup finished.")
