##
Copia incremental entre carpetas (backup)
Uso: soul run backupCarpetas.soul --folderOrigen {carpeta} --folderDestino {carpeta}
##

str folderOrigen  = arg("--folderOrigen")
str folderDestino = arg("--folderDestino")

str src = concat("/home/dmin/dev/soulc/", folderOrigen)
str dst = concat("/home/dmin/dev/soulc/", folderDestino)

printStr("Iniciando backup incremental")

printStr("ORIGEN:")
printStr(src)
printStr("DESTINO:")
printStr(dst)

# Crear carpeta destino si no existe
mkdir(dst)

# Ejecutar backup incremental
backup(src, dst)

printStr("Backup finalizado")
