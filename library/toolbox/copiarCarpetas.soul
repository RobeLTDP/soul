##
Prueba de copia paralela por workers
uso: soul run copiarCarpetas --folderOrigen {carpeta} --folderDestino {carpeta}
##

str folderOrigen  = arg("--folderOrigen")
str folderDestino = arg("--folderDestino")

str src = concat("/home/dmin/dev/soulc/", folderOrigen)
str dst = concat("/home/dmin/dev/soulc/", folderDestino)

printStr("Iniciando copia...")

printStr("ORIGEN:")
printStr(src)
printStr("DESTINO:")
printStr(dst)

copyFolder(src, dst)

printStr("Fin copia")
