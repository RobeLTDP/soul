##
Cuenta todos los ficheros dentro del directorio.
uso: soul run contarFicheros.soul --folder {carpeta}
##

int total = 0
int parcial = 0
int jpg = 0
int totaljpg = 0
int mp4 = 0
int totalmp4 = 0
int json = 0
int totaljson = 0
int carpetas = 0
int txt = 0
int totaltxt = 0

str folderOrigen = arg("--folder")
str folder = concat("/home/dmin/dev/soulc/", folderOrigen)
str base = concat(folder, "/")

printStr("Contando carpeta...")
printStr(folder)
printStr("")

diriter it = listdir(folder)

printStr(base)

while true:
    str item = dir_next(it)
    if item == 0:
        break        

    str full = concat(base, item)
    any st = stat(full)

    if isdir(st):
        carpetas = carpetas + 1 
        printStr(full)

        diriter it1 = listdir(full)

        total = total + 1
        
        while true:
            str item1 = dir_next(it1)
            if item1 == 0:
                printStr("Total Ficheros en esta carpeta:")
                print(parcial)
                printStr("Ficheros JPG:")
                print(jpg)
                printStr("Ficheros TXT:")
                print(txt)
                printStr("Ficheros MP4:")
                print(mp4)
                printStr("Ficheros JSON:")
                print(json)
                printStr("")
                int jpg = 0
                int mp4 = 0
                int json = 0
                int txt = 0                

                parcial = 0
                break      

            str full = concat(base, item1)
            any st = stat(full)
            
            total = total + 1
            parcial = parcial + 1

            if endswith(item1, ".txt"):
                txt = txt + 1
                totaltxt = totaltxt +1

            if endswith(item1, ".jpg"):
                jpg = jpg + 1
                totaljpg = totaljpg +1

            if endswith(item1, ".mp4"):
                mp4 = mp4 + 1
                totalmp4 = totalmp4 +1

            if endswith(item1, ".json"):
                json = json + 1
                totaljson = totaljson +1
                
    else: 
        str item1 = dir_next(it)
        if item1 == 0:
            break               

        if endswith(item1, ".txt"):
            txt = txt + 1
            totaltxt = totaltxt +1

        if endswith(item1, ".jpg"):
            jpg = jpg + 1
            totaljpg = totaljpg +1

        if endswith(item1, ".mp4"):
            mp4 = mp4 + 1
            totalmp4 = totalmp4 +1

        if endswith(item1, ".json"):
            json = json + 1
            totaljson = totaljson +1





dir_close(it)


printStr("ACUMULADO")
printStr("Total Ficheros:")
print(total)
printStr("Carpetas:")
print(carpetas)
printStr("Ficheros JPG:")
print(jpg)
printStr("Ficheros TXT:")
print(txt)
printStr("Ficheros MP4:")
print(mp4)
printStr("Ficheros JSON:")
print(json)
printStr("")
printStr("Finalizado.")

