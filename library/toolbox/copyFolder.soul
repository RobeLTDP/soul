##
Copy folders
usage: soul run copyFolder  --folderSrc {source_folder} --folderDst {destination_folder}
##

str folderSrc  = arg("--folderSrc")
str folderDst = arg("--folderDst")

str src = concat("/home/dmin/dev/soulc/", folderSrc)
str dst = concat("/home/dmin/dev/soulc/", folderDst)

printStr("Copying...")

printStr("Source:")
printStr(src)
printStr("Destination:")
printStr(dst)

copyFolder(src, dst)

printStr("Finished.")
