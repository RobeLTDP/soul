##
Deletes a folder and all its contents
Usage:  soul run deleteFolder.soul --folder "[folder_name]" --password 'CONFIRM_DELETE'
##

str folder = arg("--folder")
str password = arg("--password")

bool ok = true

if startswith(password, "CONFIRM_DELETE"):
    printStr(password)
    printStr("Password protection confirmed")
    ok = true
else:
    printStr(password)
    printStr("PASSWORD PROTECTION NOT APPROVED")
    ok = false

if folder == "":
    printStr("ERROR: invalid folder")
    ok = false

if startswith(folder, "/"):
    printStr("ERROR: invalid folder")
    ok = false

if folder == "..":
    printStr("ERROR: invalid folder")
    ok = false

if startswith(folder, "../"):
    printStr("ERROR: invalid folder")
    ok = false

if ok:
    folder = concat("/home/dmin/dev/soulc/", folder)

    printStr("REMOVING:")
    printStr(folder)

    if removeTree(folder) == false:
        printStr("ERROR: removeTree failed")
    else:
        printStr("DONE")
