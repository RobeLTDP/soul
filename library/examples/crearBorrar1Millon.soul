##
Crear 500.000 ficheros y borrarlos 
##

int total = 500000
int i = 0
int wId    = workerId()
int wCount = workerCount()

str folderA = "outA"
mkdir(folderA)

int lastPct = -1

while i < total:    
    folder = folderA

    str name = concat("file_", toStr(i))
    name = concat(name, ".txt")
    
    str path = concat(folder, "/")
    path = concat(path, name)

    h = open(path)
    write(h, "hello\n")
    close(h)

    i = i + 1

    int pct = (i * 100) / total
    if pct != lastPct:
        print("Progreso ", toStr(pct), "%")
        lastPct = pct

diriter it = listdir("outA")

int c = 0

while true:
    str name = dir_next(it)
    if name == 0:
        break

    str fullPath = concat("outA/", name)
    remove(fullPath)    

    c = c + 1

dir_close(it)
print(c)


