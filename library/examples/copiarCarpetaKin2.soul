#str source = "/mnt/aeds_sis/MovilMayo2020" <<< DESDE USB
str source = "/home/dmin/dev/soulc/examples/movil"
str target = "/home/dmin/dev/soulc/examples/movil2"

mkdir(target)

diriter it = listdir(source)

while true:
    str name = dir_next(it)
    if name == 0:
        break
    
    printStr(name)

    str src = concat(source, "/")
    src = concat(src, name)

    str dst = concat(target, "/")
    dst = concat(dst, name)

    copy(src, dst)

dir_close(it)
printStr("Copia finalizada")
