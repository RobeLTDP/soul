##
Test de reparto REAL de rangos para workers.
Este test solo imprime los rangos asignados a cada worker.
##

int total = 100   # puedes subirlo si quieres
int wId    = workerId()
int wCount = workerCount()

int base   = total / wCount
int extra  = total % wCount

int start = 0
int end   = 0

if wId < extra:
    start = wId * (base + 1)
    end   = start + (base + 1)
else:
    start = extra * (base + 1) + (wId - extra) * base
    end   = start + base

printStr("Worker:")
print(wId)

printStr("Start:")
print(start)

printStr("End:")
print(end)
