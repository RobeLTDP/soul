##
Creación de 1.000.000 ficheros
en la carpeta "exampleFolder2"
## 

mkdir("exampleFolder2")

int i = 0
int max = 100000

while i < max:
    str name = concat("file_", toStr(i))
    name = concat(name, ".txt")
    str path = concat("exampleFolder2/", name)

    file h = open(path)
    write(h, "Done!\n")
    close(h)

    i = i + 1

print(i)
