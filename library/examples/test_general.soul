mkdir("logs")

str logFile = "logs/work.log"
str msg = ""

diriter it = listdir("data_src")

while true:
    str name = dir_next(it)
    if name == 0:
        break

    if not endswith(name, ".dat"):
        continue

    msg = join("processed:", name)   # ojo: join mete "/"
    msg = join(msg, "\n")
    append(logFile, msg)

dir_close(it)

append(logFile, "done\n")
print(1)
