##
Genera un log JSON con mtimes de los archivos en data_src/.
Escribe el resultado en log.json.
##

diriter it = listdir("data_src")
int f = open("log.json", "w")
write(f, "[")

int c = 0
str sep = ""

while true:
    str name = dir_next(it)
    if name == 0:
        break

    str fullPath = concat("data_src/", name)
    int ts = mtime(fullPath)
    str tsStr = toStr(ts)

    str line = buildstr("{'name':", name, ",'mtime':", tsStr, "}")


    write(f, sep)
    write(f, line)

    sep = ","
    c = c + 1

write(f, "]")
close(f)
dir_close(it)
print(c)
